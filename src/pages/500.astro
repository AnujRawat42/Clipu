---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Something went wrong — ClipU" description="ClipU hit an unexpected error. Please try again.">
	<main class="bg-canvas-soft text-ink font-sans min-h-[70vh] flex items-center">
		<div class="max-w-md mx-auto px-4 py-20 text-center">
			<p class="text-sm font-medium text-mute tracking-wide">500</p>
			<h1 class="mt-3 text-[32px] font-semibold leading-10 tracking-[-1.28px]">Something went wrong</h1>
			<p class="mt-4 text-lg text-body leading-8">
				An unexpected error occurred on our end. Please try again in a moment.
			</p>
			<div class="mt-10 flex justify-center">
				<a
					href="/"
					class="rounded-pill bg-ink text-on-primary px-5 h-10 inline-flex items-center text-base font-medium hover:opacity-90"
				>
					Back to ClipU
				</a>
			</div>
		</div>
	</main>
</Layout>
